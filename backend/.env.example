# ─────────────────────────────────────────────────────
#  CEMS Backend — Environment Variable Template
#  Copy this file as `.env` and fill in your real values.
#  NEVER commit the actual `.env` file to version control.
# ─────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/cems_db?retryWrites=true&w=majority

# JWT — use a long, random secret (min 32 chars recommended)
JWT_SECRET=replace_with_a_very_long_random_secret_string_here
JWT_EXPIRES_IN=7d

# Cloudinary (for event banner / avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer (Gmail App Password recommended)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_college_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="CEMS Platform <your_college_email@gmail.com>"

# Frontend URL (used by CORS and email verification links)
CLIENT_URL=http://localhost:5173
